# Exact public origin. Required for secure production cookies and CSRF checks.
APP_ORIGIN=http://127.0.0.1:3000
APP_HOST=127.0.0.1
PORT=3000
# Absolute writable private directory; keep outside the public document root.
APP_DATA_DIR=/absolute/path/breslov-data
CATALOG_SEED_PATH=/absolute/path/breslov-next/content/catalog.json
# Read-only parent directory of the original media/ tree.
MEDIA_ROOT=/home/newbreslovtorah/public_html
# Private manifest generated by the read-only WordPress export, loaded on first start.
MEDIA_MANIFEST_PATH=/absolute/path/breslov-data/import-media.json
