# Exact public origin. Required for secure production cookies and CSRF checks.
APP_ORIGIN=http://127.0.0.1:3000
APP_HOST=127.0.0.1
PORT=3000
# Absolute writable private directory; keep outside the public document root.
APP_DATA_DIR=/absolute/path/breslov-data
CATALOG_SEED_PATH=/absolute/path/breslov-next/content/catalog.json
# Read-only parent directory of the original media/ tree.
MEDIA_ROOT=/home/newbreslovtorah/public_html
# Private manifest generated by the read-only WordPress export, loaded on first start.
MEDIA_MANIFEST_PATH=/absolute/path/breslov-data/import-media.json

# Standalone read-only watcher: npm run media:watch (or dedicated systemd service).
# Defaults to MEDIA_ROOT/media. Directory must be inside MEDIA_ROOT.
MEDIA_WATCH_DIR=/home/newbreslovtorah/public_html/media
MEDIA_WATCH_INTERVAL_MS=30000
MEDIA_WATCH_STABLE_MS=30000
# Unknown new recordings default to member-only playback; metadata is published.
MEDIA_WATCH_ACCESS=members
# Optional private JSON array of directory metadata rules; see docs/MEDIA-WATCHER.md.
# MEDIA_WATCH_RULES_PATH=/absolute/path/breslov-data/media-watch-rules.json
